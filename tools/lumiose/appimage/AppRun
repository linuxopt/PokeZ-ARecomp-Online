#!/bin/bash
# Lumiose Online AppImage entry: an installer and launcher in one file (tools/lumiose/appimage_linux.sh packs it).
# The portable "Lumiose Online Linux" folder (tools/lumiose/package_linux.sh) rides inside as payload/. It can't run
# from there: the AppImage is read-only and the package keeps everything it writes next to its program (the player's
# extracted/ game code, save/, larecomp.ini, lumiose/ mod state: runtime/paths.c's portable root, the folder that has
# extracted/). So the first start copies it to a writable folder, adds a menu entry and starts it from there; a newer
# AppImage later updates that copy in place through linux_launcher_update.py (journaled, player data never touched),
# the same installer the start screen's "Update now" uses. Folder: $LUMIOSE_INSTALL_DIR, else
# $XDG_DATA_HOME/lumiose-online (~/.local/share/lumiose-online) - not zarecomp/, plain ZA Recomp's own data folder.
set -euo pipefail
HERE=$(dirname "$(readlink -f "$0")")
PAYLOAD=$HERE/payload
DATA_HOME=${XDG_DATA_HOME:-$HOME/.local/share}
[[ $DATA_HOME == /* ]] || DATA_HOME=$HOME/.local/share  # (the XDG spec: a relative value is invalid, ignored)
DEST=${LUMIOSE_INSTALL_DIR:-$DATA_HOME/lumiose-online}
DESKTOP_FILE=$DATA_HOME/applications/lumiose-online.desktop
TITLE='Lumiose Online'

# ---- talking to the player: a terminal when there is one, else a dialog (zenity on GNOME & co, kdialog on KDE)
gui() { [ ! -t 2 ] && [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; }
fail() {
    echo "$TITLE: $1" >&2
    if gui; then
        if command -v zenity >/dev/null; then zenity --error --title="$TITLE" --no-wrap --no-markup --text="$1" 2>/dev/null || true
        elif command -v kdialog >/dev/null; then kdialog --title "$TITLE" --error "$1" 2>/dev/null || true
        elif command -v notify-send >/dev/null; then notify-send -u critical "$TITLE" "$1" 2>/dev/null || true; fi
    fi
    exit 1
}
ask() {  # question -> yes? (no way to ask: no)
    if [ -t 0 ] && [ -t 2 ]; then
        local a; read -r -p "$1 [y/N] " a; [[ $a == [yY]* ]]
    elif gui && command -v zenity >/dev/null; then zenity --question --title="$TITLE" --no-wrap --no-markup --text="$1" 2>/dev/null
    elif gui && command -v kdialog >/dev/null; then kdialog --title "$TITLE" --yesno "$1" 2>/dev/null
    else return 1; fi
}
busy() {  # message, command...: runs it, with a pulsing progress window when there's no terminal to print to
    echo "$1" >&2
    if gui && command -v zenity >/dev/null; then
        local status; status=$(mktemp)
        { "${@:2}"; echo $? > "$status"; } 2>&1 | zenity --progress --pulsate --auto-close --no-cancel \
            --title="$TITLE" --text="$1" 2>/dev/null || true
        local rc; rc=$(cat "$status" 2>/dev/null || echo 1); rm -f "$status"
        return "${rc:-1}"
    fi
    if gui && command -v notify-send >/dev/null; then notify-send "$TITLE" "$1" 2>/dev/null || true; fi
    "${@:2}"
}

version_of() {  # install folder -> its launcher version (entry.py's LAUNCHER_VERSION: the start screen's updater keeps
    # it current, so an install updated from inside the game is never "updated" back to an older AppImage)
    sed -n "s/^LAUNCHER_VERSION = '\(v[0-9][0-9.]*\)'.*/\1/p" "$1/usr/bin/tools/lumiose/entry.py" 2>/dev/null | head -1
}
newer() { [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1)" = "$1" ]; }  # $1 > $2?

desktop_quote() {  # a path as one quoted Exec= argument (Desktop Entry spec: \ " ` $ escaped inside the quotes,
    # then every \ doubled for the string itself, and % doubled for the field codes)
    local s; s=$(printf '%s' "$1" | sed -e 's/[\\"`$]/\\&/g' -e 's/\\/\\\\/g' -e 's/%/%%/g')
    printf '"%s"' "$s"
}
install_menu_entry() {
    mkdir -p "$(dirname "$DESKTOP_FILE")"
    local tmp=$DESKTOP_FILE.tmp
    cat > "$tmp" <<EOF
[Desktop Entry]
Type=Application
Name=Lumiose Online
GenericName=Pokémon Legends: Z-A online
Comment=ZA Recomp with Lumiose Online (bring your own game files)
Exec=$(desktop_quote "$DEST/Lumiose Online")
Icon=$DEST/usr/bin/icon.png
Terminal=false
Categories=Game;
StartupNotify=true
Actions=OpenFolder;

[Desktop Action OpenFolder]
Name=Open install folder
Exec=xdg-open $(desktop_quote "$DEST")
EOF
    mv -f "$tmp" "$DESKTOP_FILE"
    command -v update-desktop-database >/dev/null && update-desktop-database -q "$(dirname "$DESKTOP_FILE")" 2>/dev/null || true
}

fresh_install() {
    local part=$DEST.partial
    rm -rf -- "$part"  # (a copy an earlier start didn't finish: never the install itself, only ever renamed into place)
    mkdir -p -- "$part"
    cp -a -- "$PAYLOAD/." "$part/"
    chmod -R u+w -- "$part"  # (the AppImage's files can be read-only: the start screen's updater must replace them)
    if [ -e "$DEST" ]; then rmdir -- "$DEST"; fi  # (only an empty folder: checked before)
    mv -- "$part" "$DEST"
}
update_install() {  # the bundled Python and updater: the installed ones may be older
    "$PAYLOAD/usr/bin/python/bin/python3.12" -I "$PAYLOAD/usr/bin/tools/lumiose/linux_launcher_update.py" \
        --root "$DEST" --from-dir "$PAYLOAD"
}

install_or_update() {  # force: reinstall the program files even at the same version (--repair)
    local force=${1:-0} bundled installed
    bundled=$(version_of "$PAYLOAD")
    [ -n "$bundled" ] || fail "This AppImage is incomplete (no launcher version). Download it again."
    if [ -f "$DEST/Lumiose Online" ] && [ -d "$DEST/usr/bin" ]; then
        installed=$(version_of "$DEST")
        if [ "$force" = 1 ] || [ -z "$installed" ] || newer "$bundled" "$installed"; then
            busy "Updating Lumiose Online ${installed:-?} to $bundled in $DEST. Your saves and settings are kept." \
                update_install || fail "The update could not be installed. Your previous version, game files and saves were kept.
See the messages above, or run this AppImage from a terminal for details."
        fi
    elif [ -e "$DEST" ] && [ -n "$(ls -A -- "$DEST" 2>/dev/null)" ]; then
        fail "$DEST already exists and is not a Lumiose Online installation; nothing was changed.
Choose another folder with LUMIOSE_INSTALL_DIR=/path/to/folder."
    else
        mkdir -p -- "$(dirname -- "$DEST")" || fail "Could not create $(dirname -- "$DEST")."
        busy "Installing Lumiose Online $bundled to $DEST..." fresh_install ||
            { rm -rf -- "$DEST.partial"; fail "Lumiose Online could not be installed to $DEST (is there enough free space? About 3 GB, plus about 12 GB for the game once it is set up)."; }
    fi
    install_menu_entry
}

uninstall() {
    rm -f -- "$DESKTOP_FILE"
    command -v update-desktop-database >/dev/null && update-desktop-database -q "$(dirname "$DESKTOP_FILE")" 2>/dev/null || true
    echo "Removed the menu entry." >&2
    if [ -f "$DEST/Lumiose Online" ]; then
        if ask "Also delete $DEST?
This deletes Lumiose Online together with your SAVES (usr/bin/save), settings and prepared game files.
Back up usr/bin/save first if you want to keep your progress."; then
            rm -rf -- "$DEST"
            echo "Deleted $DEST." >&2
        else
            echo "Kept $DEST (program, saves and game files). Delete that folder yourself to remove everything." >&2
        fi
    fi
}

case ${1:-} in
    --help|-h)
        cat <<EOF
Lumiose Online for ZA Recomp (Linux AppImage)

  (no option)   install or update into $DEST, then start Lumiose Online
  --install     install or update, and add the menu entry, without starting it
  --repair      reinstall the program files from this AppImage, without starting it (saves and game files are kept)
  --uninstall   remove the menu entry, then ask before deleting the install folder (it holds your saves)
  --where       print the install folder

LUMIOSE_INSTALL_DIR=/path chooses another install folder. You supply your own Pokémon Legends: Z-A 2.0.2 game files.
EOF
        exit 0 ;;
    --where) echo "$DEST"; exit 0 ;;
    --uninstall) uninstall; exit 0 ;;
    --install) install_or_update 0; echo "Lumiose Online is installed in $DEST and in your applications menu." >&2; exit 0 ;;
    --repair) install_or_update 1; echo "Reinstalled the program files in $DEST; saves and game files were kept." >&2; exit 0 ;;
    *) install_or_update 0 ;;
esac

# The installed copy is a plain folder program: it must not think it runs inside this AppImage (runtime/paths.c checks
# paths against APPDIR, runtime/platform/linux.c labels the log "AppImage" from APPIMAGE).
unset APPDIR APPIMAGE ARGV0 OWD
exec "$DEST/Lumiose Online" "$@"
